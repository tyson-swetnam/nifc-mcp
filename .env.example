# NIFC MCP Server Configuration

# Server Configuration
LOG_LEVEL=info
CACHE_TTL_SECONDS=300  # 5 minutes (active fire data updates frequently)

# Data Source Configuration
ENABLE_PERIMETER_DATA=true
ENABLE_INCIWEB_INTEGRATION=true
ENABLE_IRWIN_DATA=true

# Feature Flags
INCLUDE_HISTORICAL_FIRES=true
MAX_FIRES_PER_QUERY=100
PROXIMITY_ALERT_RADIUS_MILES=50

# Optional: Custom cache settings
# CACHE_MAX_SIZE=1000
# CACHE_CLEANUP_INTERVAL=600

# Optional: API endpoints (defaults provided)
# NIFC_ARCGIS_BASE_URL=https://services3.arcgis.com/T4QMspbfLg3qTGWY/arcgis/rest/services
# INCIWEB_API_URL=https://inciweb.nwcg.gov/
# IRWIN_API_URL=https://irwin.doi.gov/

# Optional: GeoJSON processing
SIMPLIFY_PERIMETERS=true
COORDINATE_PRECISION=4
